# Copie este arquivo para ".env" (o script start.sh faz isso automaticamente)
# e ajuste se quiser. Na maioria dos casos não precisa mexer em nada.

# Porta em que o WebODM vai responder no navegador (http://IP-DO-HUB:8000)
WO_PORT=8000

# Não precisa alterar - usado internamente pelo WebODM
WO_HOST=localhost

# Chave secreta do Django. O start.sh preenche isso automaticamente com um
# valor aleatório na primeira execução. Não compartilhe este valor.
WO_SECRET_KEY=

# Quantos processos web simultâneos rodar. Em máquinas fracas, deixe em 1.
WEB_CONCURRENCY=1
